# --- Area do administrador (/admin) ---
# Senha de acesso ao /admin. Use uma senha longa e unica.
ADMIN_PASSWORD=troque-por-uma-senha-longa

# Segredo para assinar o cookie de login (qualquer texto aleatorio longo).
SESSION_SECRET=troque-por-um-texto-aleatorio-longo

# --- Banco de dados (Vercel Edge Config) ---
# EDGE_CONFIG e criada automaticamente pela Vercel ao conectar o Edge Config ao projeto.
EDGE_CONFIG=

# Token da Vercel (Account Settings > Tokens) usado SOMENTE no servidor para gravar no Edge Config.
VERCEL_API_TOKEN=

# Apenas se o projeto estiver dentro de um Team da Vercel (ex.: team_xxxx).
VERCEL_TEAM_ID=
